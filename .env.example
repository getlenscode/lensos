# Copy this file to .env and fill in your keys.
# Used by server/transcribe_server.py for Groq Whisper transcription.
GROQ_API_KEY=your-groq-api-key
# Used by the LiteLLM proxy for the Pi agent model (OpenRouter key works here too;
# entrypoint.sh also accepts OPENROUTER_API_KEY directly).
OPENAI_API_KEY=your-api-key
# Optional Pi model alias served by the LiteLLM proxy (see server/litellm_config.yaml).
VOICEOS_PI_MODEL=litellm/deepseek-v4.1-flash
# Optional: let the Pi agent capture screenshots (off by default). Images are
# downscaled and limited to three per request. Set to 1 to enable.
VOICEOS_SCREENSHOTS=0
